@typeparam TItem
@* Tabela com cabeçalho, uma linha por item e mensagem quando a lista está vazia. *@
@if (Itens is null)
{
    <p class="carregando">Carregando...</p>
}
else if (Itens.Count == 0)
{
    <p class="vazio">@MensagemVazia</p>
}
else
{
    <div class="tabela-rolagem">
        <table class="tabela">
            <thead><tr>@Cabecalho</tr></thead>
            <tbody>
                @foreach (var item in Itens)
                {
                    <tr>@Linha(item)</tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>null enquanto carrega.</summary>
    [Parameter] public IReadOnlyList<TItem>? Itens { get; set; }
    [Parameter, EditorRequired] public RenderFragment Cabecalho { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> Linha { get; set; } = default!;
    [Parameter] public string MensagemVazia { get; set; } = "Nenhum registro cadastrado.";
}
