@typeparam TItem
@* Equivale ao DataTable: cabeçalho, uma linha por item e mensagem quando vazio. *@
<div class="table-wrap">
    <table>
        <thead><tr>@Cabecalho</tr></thead>
        <tbody>
            @if (Itens is null)
            {
                <tr><td colspan="@Colunas" class="py-10 text-center text-slate-400">Carregando...</td></tr>
            }
            else if (Itens.Count == 0)
            {
                <tr><td colspan="@Colunas" class="py-10 text-center text-slate-400">@MensagemVazia</td></tr>
            }
            else
            {
                @foreach (var item in Itens)
                {
                    <tr>@Linha(item)</tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    /// <summary>null enquanto carrega.</summary>
    [Parameter] public IReadOnlyList<TItem>? Itens { get; set; }
    [Parameter, EditorRequired] public RenderFragment Cabecalho { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> Linha { get; set; } = default!;
    [Parameter] public string MensagemVazia { get; set; } = "Nenhum registro encontrado.";

    /// <summary>Quantidade de colunas, para a mensagem ocupar a linha inteira.</summary>
    [Parameter] public int Colunas { get; set; } = 1;
}
