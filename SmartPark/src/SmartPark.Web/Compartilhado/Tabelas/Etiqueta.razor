@* Etiqueta de status. Equivale ao StatusBadge. *@
<span class="status status-@Tom">@Texto</span>

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = "";

    /// <summary>success, warning, danger, info ou neutral (ver CoresStatus).</summary>
    [Parameter] public string Tom { get; set; } = "neutral";
}
