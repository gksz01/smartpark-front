@* Botões Editar e Excluir de uma linha, com diálogo de confirmação. Equivale ao RowActions + ConfirmDialog. *@
<div class="@Classe">
    @ChildContent
    @if (AoEditar.HasDelegate)
    {
        <button type="button" class="button button-secondary" @onclick="AoEditar" aria-label="@($"Editar {Rotulo}")"><Icone Nome="Edit3" Tamanho="16" /> Editar</button>
    }
    @if (AoExcluir.HasDelegate)
    {
        <button type="button" class="button button-ghost" @onclick="() => _confirmando = true" aria-label="@($"Excluir {Rotulo}")"><Icone Nome="Trash2" Tamanho="16" /> Excluir</button>
    }
</div>

@if (_confirmando)
{
    <DialogoConfirmacao Titulo="@($"Excluir {Rotulo}?")" Descricao="@DescricaoExclusao" AoConfirmar="ConfirmarAsync" AoCancelar="() => _confirmando = false" />
}

@code {
    /// <summary>O que está na linha (ex.: "veículo BRA2E19"), usado nos rótulos e na confirmação.</summary>
    [Parameter, EditorRequired] public string Rotulo { get; set; } = "";
    [Parameter] public string DescricaoExclusao { get; set; } = "Esta ação não pode ser desfeita.";
    [Parameter] public EventCallback AoEditar { get; set; }
    [Parameter] public EventCallback AoExcluir { get; set; }
    [Parameter] public string Classe { get; set; } = "flex gap-2";

    /// <summary>Ações próprias do CRUD, antes de Editar (ex.: Cancelar reserva, Simular sensor).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _confirmando;

    private async Task ConfirmarAsync()
    {
        _confirmando = false;
        await AoExcluir.InvokeAsync();
    }
}
