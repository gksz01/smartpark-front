@* Desenha uma lista de CampoFormulario. Equivale ao FormFields. *@
@foreach (var campo in Campos.Where(campo => campo.Visivel?.Invoke() ?? true))
{
    @if (campo.Tipo == TipoCampo.Selecao)
    {
        <CampoSelecao Rotulo="@campo.Rotulo" Valor="@campo.Ler()" Opcoes="campo.Opcoes" Desabilitado="campo.Desabilitado" Dica="@campo.Dica"
                      ValorChanged="EventCallback.Factory.Create<string>(this, campo.Gravar)" />
    }
    else
    {
        <label class="form-field">
            <span>@campo.Rotulo</span>
            <input type="@TipoHtml(campo.Tipo)" value="@campo.Ler()" placeholder="@campo.Exemplo" disabled="@campo.Desabilitado" required="@(!campo.Opcional)"
                   step="@(campo.Tipo == TipoCampo.Numero ? "any" : null)"
                   @onchange="evento => campo.Gravar(evento.Value?.ToString() ?? string.Empty)" />
            @if (!string.IsNullOrEmpty(campo.Dica))
            {
                <small>@campo.Dica</small>
            }
        </label>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CampoFormulario> Campos { get; set; } = [];

    private static string TipoHtml(TipoCampo tipo) => tipo switch
    {
        TipoCampo.Numero => "number",
        TipoCampo.Data => "date",
        TipoCampo.Hora => "time",
        _ => "text",
    };
}
