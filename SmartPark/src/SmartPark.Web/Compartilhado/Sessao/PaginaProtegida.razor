@* Só mostra a tela se o perfil tiver a permissão e o tenant tiver o recurso. Equivale ao ProtectedRoute + AccessDenied. *@
@inject SessaoUsuario Sessao

@if (Motivo is { } motivo)
{
    <main class="min-h-screen bg-slate-50 p-6 grid place-items-center">
        <Cartao Classe="max-w-lg text-center p-10">
            <div class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-amber-50 text-amber-600"><Icone Nome="AlertTriangle" /></div>
            <p class="eyebrow">Acesso protegido</p>
            <h1 class="mt-2 text-2xl font-bold">Conteúdo indisponível</h1>
            <p class="mt-3 text-slate-500">@motivo</p>
            <a class="button button-primary mt-7 inline-flex" href="/">Trocar cliente ou perfil <Icone Nome="ArrowRight" Tamanho="16" /></a>
        </Cartao>
    </main>
}
else
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public Permissao Permissao { get; set; }
    [Parameter] public Recurso? Recurso { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Motivo => !Sessao.Conectado
        ? "Escolha um cliente e um perfil para usar o SmartPark."
        : Sessao.PodeAcessar(Permissao, Recurso) ? null
        : Recurso is { } necessario && !Sessao.Tenant!.PossuiRecurso(necessario)
            ? $"O módulo {Rotulos.De(necessario)} não está disponível para {Sessao.Tenant.Nome}."
            : $"O perfil {Rotulos.De(Sessao.Perfil)} não tem acesso a esta área.";
}
