@* Ícone Lucide (mesmo desenho da versão React). Ex.: <Icone Nome="Car" Tamanho="20" /> *@
<svg xmlns="http://www.w3.org/2000/svg" width="@Tamanho" height="@Tamanho" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true">
    @((MarkupString)Icones.Desenhos[Nome])
</svg>

@code {
    [Parameter, EditorRequired] public string Nome { get; set; } = "";
    [Parameter] public int Tamanho { get; set; } = 24;
}
