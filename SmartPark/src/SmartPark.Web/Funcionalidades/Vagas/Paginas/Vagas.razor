@page "/vagas"
@using SmartPark.Aplicacao.Vagas
@using SmartPark.Aplicacao.Vagas.Atualizar
@using SmartPark.Aplicacao.Vagas.Criar
@using SmartPark.Aplicacao.Vagas.Excluir
@using SmartPark.Aplicacao.Vagas.Listar
@using SmartPark.Aplicacao.Vagas.SimularSensor
@inject SessaoUsuario Sessao
@inject ExecutorCasosDeUso CasosDeUso

<PageTitle>Vagas e setores · SmartPark</PageTitle>

<PaginaProtegida Permissao="Permissao.Vagas">
    <div class="admin-page">
        <CabecalhoPagina Sobretitulo="Capacidade operacional" Titulo="Vagas e setores" Descricao="Acompanhe disponibilidade e categorias em uma visão unificada.">
            <button type="button" class="button button-primary" @onclick="AbrirNovo"><Icone Nome="Plus" Tamanho="17" /> Nova vaga</button>
        </CabecalhoPagina>
        <InfoVariacao>
            A mesma tabela representa todos os clientes. Os tipos oferecidos vêm de TiposVaga (Prioritária no Hospital, Nominal no Condomínio,
            Restrita na Empresa) e cada tipo é criado pelo seu Creator do Factory Method. "Simular sensor" usa o Observer: o Sensor avisa
            ObservadorVagaSensor (muda a vaga) e ObservadorNotificacaoSensor (gera a notificação).
        </InfoVariacao>
        <Mensagem Sucesso="@_estado.Sucesso" Erro="@_estado.Erro" />

        <div class="space-summary">
            @foreach (var status in Enum.GetValues<StatusVaga>())
            {
                <button type="button" class="@(_filtroStatus == status ? "active" : "")" @onclick="() => _filtroStatus = _filtroStatus == status ? null : status">
                    <span class="space-dot @status.ToString().ToLowerInvariant()"></span>
                    <div><strong>@((_vagas ?? []).Count(vaga => vaga.Status == status))</strong><small>@(status)s</small></div>
                </button>
            }
        </div>

        <Cartao>
            <div class="table-toolbar">
                <div><h2>Mapa lógico de vagas</h2><p>@Visiveis.Count registros visíveis</p></div>
                <div class="filter-selects">
                    <select aria-label="Filtrar por setor" value="@(_filtroSetor ?? "Todos")" @onchange="FiltrarSetor">
                        <option>Todos</option>
                        @foreach (var setor in Setores)
                        {
                            <option>@setor</option>
                        }
                    </select>
                    <select aria-label="Filtrar por status" value="@(_filtroStatus?.ToString() ?? "Todas")" @onchange="FiltrarStatus">
                        <option>Todas</option>
                        @foreach (var status in Enum.GetValues<StatusVaga>())
                        {
                            <option>@status</option>
                        }
                    </select>
                </div>
            </div>
            <TabelaDados Itens="_vagas is null ? null : Visiveis" Colunas="5" MensagemVazia="Nenhuma vaga cadastrada.">
                <Cabecalho><th>Vaga</th><th>Setor</th><th>Categoria</th><th>Status</th><th>Ações</th></Cabecalho>
                <Linha Context="vaga">
                    <td><strong>@vaga.Codigo</strong></td>
                    <td>Setor @vaga.Setor</td>
                    <td><div><span class="inline-flex items-center gap-2"><Icone Nome="Car" Tamanho="15" />@Rotulos.De(vaga.Tipo)</span><small class="table-subtitle">@vaga.Requisito</small></div></td>
                    <td><Etiqueta Texto="@vaga.Status.ToString()" Tom="@CoresStatus.De(vaga.Status)" /></td>
                    <td>
                        <AcoesLinha Rotulo="@($"vaga {vaga.Codigo}")" DescricaoExclusao="Somente vagas livres ou bloqueadas podem ser excluídas."
                                    AoEditar="() => AbrirEdicao(vaga)" AoExcluir="() => ExcluirAsync(vaga)">
                            @if (vaga.Status != StatusVaga.Bloqueada)
                            {
                                <button type="button" class="button button-secondary" @onclick="() => SimularSensorAsync(vaga)" aria-label="@($"Simular sensor na vaga {vaga.Codigo}")"><Icone Nome="Activity" Tamanho="16" /> Simular sensor</button>
                            }
                        </AcoesLinha>
                    </td>
                </Linha>
            </TabelaDados>
        </Cartao>
    </div>

    <ModalFormulario Aberto="_estado.ModalAberto" Sobretitulo="Cadastro de vagas" Titulo="@(_estado.Editando ? $"Editar vaga {_formulario.Codigo}" : "Nova vaga")" TextoSalvar="Salvar vaga"
                     Erro="@_estado.ErroFormulario" Salvando="_estado.Salvando" AoSalvar="SalvarAsync" AoFechar="_estado.Fechar">
        <CamposFormulario Campos="Campos" />
    </ModalFormulario>
</PaginaProtegida>

@code {
    private readonly EstadoCrud _estado = new();
    private IReadOnlyList<VagaDto>? _vagas;
    private StatusVaga? _filtroStatus;
    private string? _filtroSetor;
    private Formulario _formulario = new();

    private sealed class Formulario
    {
        public string Codigo { get; set; } = "";
        public string Setor { get; set; } = "";
        public TipoVaga Tipo { get; set; }
        public StatusVaga Status { get; set; } = StatusVaga.Livre;

        public DadosVaga ParaDados() => new(Codigo, Setor, Tipo, Status);
    }

    private IReadOnlyList<string> Setores => (_vagas ?? []).Select(vaga => vaga.Setor).Distinct().Order().ToList();

    private IReadOnlyList<VagaDto> Visiveis => (_vagas ?? [])
        .Where(vaga => (_filtroStatus is null || vaga.Status == _filtroStatus) && (_filtroSetor is null || vaga.Setor == _filtroSetor))
        .ToList();

    // O tipo só é escolhido na criação: a subclasse da vaga (produto do Factory Method) não muda depois
    private IReadOnlyList<CampoFormulario> Campos =>
    [
        CampoFormulario.Texto("Código", () => _formulario.Codigo, valor => _formulario.Codigo = valor, "Ex.: A-05"),
        CampoFormulario.Texto("Setor", () => _formulario.Setor, valor => _formulario.Setor = valor, "Ex.: A"),
        CampoFormulario.Selecao("Tipo", () => _formulario.Tipo, valor => _formulario.Tipo = valor, Sessao.Tenant!.TiposVaga)
            with { Desabilitado = _estado.Editando, Dica = _estado.Editando ? "O tipo é definido na criação da vaga." : null },
        CampoFormulario.Selecao("Status", () => _formulario.Status, valor => _formulario.Status = valor, Enum.GetValues<StatusVaga>()),
    ];

    // "Todos" e "Todas" desligam o filtro
    private void FiltrarSetor(ChangeEventArgs evento) =>
        _filtroSetor = evento.Value?.ToString() is { } setor && setor != "Todos" ? setor : null;

    private void FiltrarStatus(ChangeEventArgs evento) =>
        _filtroStatus = Enum.TryParse<StatusVaga>(evento.Value?.ToString(), out var status) ? status : null;

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        if (!Sessao.PodeAcessar(Permissao.Vagas)) return;
        var resultado = await CasosDeUso.ExecutarAsync((ListarVagasManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId)));
        if (resultado.Sucesso) _vagas = resultado.Dados;
        else _estado.InformarErro(resultado.Erro);
    }

    private void AbrirNovo()
    {
        _formulario = new() { Tipo = Sessao.Tenant!.TiposVaga[0] };
        _estado.AbrirNovo();
    }

    private void AbrirEdicao(VagaDto vaga)
    {
        _formulario = new() { Codigo = vaga.Codigo, Setor = vaga.Setor, Tipo = vaga.Tipo, Status = vaga.Status };
        _estado.AbrirEdicao(vaga.Id);
    }

    private async Task SalvarAsync()
    {
        _estado.Salvando = true;
        var resultado = _estado.IdEditando is int id
            ? await CasosDeUso.ExecutarAsync((AtualizarVagaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, id, _formulario.ParaDados())))
            : await CasosDeUso.ExecutarAsync((CriarVagaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, _formulario.ParaDados())));
        var mensagem = resultado.Dados is { } vaga ? $"Vaga {vaga.Codigo} {(_estado.Editando ? "atualizada" : "cadastrada")} com sucesso." : "";
        if (_estado.ConcluirFormulario(resultado.Sucesso, resultado.Erro, mensagem)) await CarregarAsync();
    }

    private async Task ExcluirAsync(VagaDto vaga)
    {
        var resultado = await CasosDeUso.ExecutarAsync((ExcluirVagaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, vaga.Id)));
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, "Vaga excluída.")) await CarregarAsync();
    }

    /// <summary>Vaga ocupada: o sensor detecta a saída; caso contrário, a chegada de um veículo.</summary>
    private async Task SimularSensorAsync(VagaDto vaga)
    {
        var leitura = vaga.Status == StatusVaga.Ocupada ? TipoEventoSensor.Liberada : TipoEventoSensor.Ocupada;
        var resultado = await CasosDeUso.ExecutarAsync((SimularSensorManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, vaga.Id, leitura)));
        var mensagem = resultado.Dados is { } leituraSensor
            ? string.Join(" ", leituraSensor.Notificacoes) is { Length: > 0 } notificacoes ? notificacoes : $"Vaga {leituraSensor.Vaga.Codigo}: {leituraSensor.Vaga.Status}."
            : "";
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, mensagem)) await CarregarAsync();
    }
}
