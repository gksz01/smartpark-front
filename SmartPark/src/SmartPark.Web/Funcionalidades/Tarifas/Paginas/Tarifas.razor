@page "/tarifas"
@using SmartPark.Aplicacao.Tarifas
@using SmartPark.Aplicacao.Tarifas.Atualizar
@using SmartPark.Aplicacao.Tarifas.Criar
@using SmartPark.Aplicacao.Tarifas.Excluir
@using SmartPark.Aplicacao.Tarifas.Listar
@inject SessaoUsuario Sessao
@inject ExecutorCasosDeUso CasosDeUso

<PageTitle>Tarifas · SmartPark</PageTitle>

<PaginaProtegida Permissao="Permissao.Configuracao" Recurso="Recurso.Cobranca">
    <div class="admin-page">
        <CabecalhoPagina Sobretitulo="Cobrança" Titulo="Tarifas"
                         Descricao="@($"Regras de preço do estacionamento de {Sessao.Tenant!.Nome}. A tarifa ativa será usada em reservas e pagamentos.")">
            <button type="button" class="button button-primary" @onclick="AbrirNovo"><Icone Nome="Plus" Tamanho="17" /> Nova tarifa</button>
        </CabecalhoPagina>
        <InfoVariacao>
            Esta tela só existe quando o recurso Cobrança está ligado (Shopping e Hospital). Cada tipo de cálculo é uma Strategy:
            a coluna "Simulação 3h" vem de tarifa.Calcular(3), e a classe Tarifa delega para TarifaPorHora, TarifaFixaDiaria ou TarifaIsenta.
        </InfoVariacao>
        <Mensagem Sucesso="@_estado.Sucesso" Erro="@_estado.Erro" />

        <Cartao>
            <div class="table-toolbar">
                <div><h2>Tarifas cadastradas</h2><p>@((_tarifas ?? []).Count) tarifas · no máximo uma ativa</p></div>
            </div>
            <TabelaDados Itens="_tarifas" Colunas="6" MensagemVazia="Nenhuma tarifa cadastrada.">
                <Cabecalho><th>Nome</th><th>Tipo</th><th>Configuração</th><th>Simulação 3h</th><th>Situação</th><th>Ações</th></Cabecalho>
                <Linha Context="tarifa">
                    <td><strong>@tarifa.Nome</strong></td>
                    <td>@Rotulos.De(tarifa.TipoEstrategia)</td>
                    <td>@tarifa.Descricao</td>
                    <td><strong>@Formatacao.FormatarMoeda(tarifa.Simulacao3h)</strong></td>
                    <td><Etiqueta Texto="@(tarifa.Ativa ? "Ativa" : "Inativa")" Tom="@CoresStatus.DeAtivo(tarifa.Ativa)" /></td>
                    <td>
                        <AcoesLinha Rotulo="@tarifa.Nome" DescricaoExclusao="Somente tarifas inativas podem ser excluídas."
                                    AoEditar="() => AbrirEdicao(tarifa)" AoExcluir="() => ExcluirAsync(tarifa)">
                            @if (!tarifa.Ativa)
                            {
                                <button type="button" class="button button-secondary" @onclick="() => AtivarAsync(tarifa)" aria-label="@($"Ativar {tarifa.Nome}")"><Icone Nome="CheckCircle2" Tamanho="16" /> Ativar</button>
                            }
                        </AcoesLinha>
                    </td>
                </Linha>
            </TabelaDados>
        </Cartao>
    </div>

    <ModalFormulario Aberto="_estado.ModalAberto" Sobretitulo="Cadastro de tarifas" Titulo="@(_estado.Editando ? "Editar tarifa" : "Nova tarifa")" TextoSalvar="Salvar tarifa"
                     Erro="@_estado.ErroFormulario" Salvando="_estado.Salvando" AoSalvar="SalvarAsync" AoFechar="_estado.Fechar">
        <CamposFormulario Campos="Campos" />
    </ModalFormulario>
</PaginaProtegida>

@code {
    private readonly EstadoCrud _estado = new();
    private IReadOnlyList<TarifaDto>? _tarifas;
    private Formulario _formulario = new();

    private sealed class Formulario
    {
        public string Nome { get; set; } = "";
        public TipoEstrategiaTarifa Tipo { get; set; } = TipoEstrategiaTarifa.PorHora;
        public decimal? Valor { get; set; }
        public decimal? Teto { get; set; }
        public bool Ativa { get; set; }

        // Só a tarifa por hora usa teto; a isenta não usa valor
        public DadosTarifa ParaDados() => new(Nome, Tipo, Tipo == TipoEstrategiaTarifa.Isenta ? 0 : Valor ?? 0,
            Tipo == TipoEstrategiaTarifa.PorHora ? Teto : null, Ativa);
    }

    // Só os campos que cada tipo de cálculo usa (o cálculo em si fica na Strategy)
    private IReadOnlyList<CampoFormulario> Campos =>
    [
        CampoFormulario.Texto("Nome", () => _formulario.Nome, valor => _formulario.Nome = valor, "Ex.: Tarifa padrão"),
        CampoFormulario.Selecao("Tipo de cálculo", () => _formulario.Tipo, valor => _formulario.Tipo = valor, Enum.GetValues<TipoEstrategiaTarifa>()),
        CampoFormulario.Numero(_formulario.Tipo == TipoEstrategiaTarifa.Diaria ? "Valor da diária (R$)" : "Valor da hora (R$)", () => _formulario.Valor, valor => _formulario.Valor = valor)
            with { Visivel = () => _formulario.Tipo != TipoEstrategiaTarifa.Isenta },
        CampoFormulario.Numero("Teto diário (R$)", () => _formulario.Teto, valor => _formulario.Teto = valor)
            with { Dica = "Opcional", Opcional = true, Visivel = () => _formulario.Tipo == TipoEstrategiaTarifa.PorHora },
        CampoFormulario.Booleano("Situação", () => _formulario.Ativa, valor => _formulario.Ativa = valor, "Ativa (desativa a atual)", "Inativa"),
    ];

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        if (!Sessao.PodeAcessar(Permissao.Configuracao, Recurso.Cobranca)) return;
        var resultado = await CasosDeUso.ExecutarAsync((ListarTarifasManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId)));
        if (resultado.Sucesso) _tarifas = resultado.Dados;
        else _estado.InformarErro(resultado.Erro);
    }

    private void AbrirNovo()
    {
        _formulario = new();
        _estado.AbrirNovo();
    }

    private void AbrirEdicao(TarifaDto tarifa)
    {
        _formulario = new() { Nome = tarifa.Nome, Tipo = tarifa.TipoEstrategia, Valor = tarifa.Valor, Teto = tarifa.ValorMaximoDiario, Ativa = tarifa.Ativa };
        _estado.AbrirEdicao(tarifa.Id);
    }

    private async Task SalvarAsync()
    {
        _estado.Salvando = true;
        var editando = _estado.Editando;
        var resultado = _estado.IdEditando is int id
            ? await CasosDeUso.ExecutarAsync((AtualizarTarifaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, id, _formulario.ParaDados())))
            : await CasosDeUso.ExecutarAsync((CriarTarifaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, _formulario.ParaDados())));
        var mensagem = resultado.Dados is { } tarifa ? $"Tarifa {tarifa.Nome} {(editando ? "atualizada" : "cadastrada")} com sucesso." : "";
        if (_estado.ConcluirFormulario(resultado.Sucesso, resultado.Erro, mensagem)) await CarregarAsync();
    }

    /// <summary>Atalho para ativar: salva a mesma tarifa com Ativa = true (a anterior é desativada no caso de uso).</summary>
    private async Task AtivarAsync(TarifaDto tarifa)
    {
        var dados = new DadosTarifa(tarifa.Nome, tarifa.TipoEstrategia, tarifa.Valor, tarifa.ValorMaximoDiario, Ativa: true);
        var resultado = await CasosDeUso.ExecutarAsync((AtualizarTarifaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, tarifa.Id, dados)));
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, $"Tarifa {tarifa.Nome} ativada. A anterior foi desativada.")) await CarregarAsync();
    }

    private async Task ExcluirAsync(TarifaDto tarifa)
    {
        var resultado = await CasosDeUso.ExecutarAsync((ExcluirTarifaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, tarifa.Id)));
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, "Tarifa excluída.")) await CarregarAsync();
    }
}
