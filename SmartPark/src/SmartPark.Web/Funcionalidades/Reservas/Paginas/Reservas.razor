@page "/reservas"
@using SmartPark.Aplicacao.Reservas
@using SmartPark.Aplicacao.Reservas.Atualizar
@using SmartPark.Aplicacao.Reservas.Cancelar
@using SmartPark.Aplicacao.Reservas.Criar
@using SmartPark.Aplicacao.Reservas.Excluir
@using SmartPark.Aplicacao.Reservas.Listar
@using SmartPark.Aplicacao.Vagas.Listar
@using SmartPark.Aplicacao.Veiculos.Listar
@inject SessaoUsuario Sessao
@inject ExecutorCasosDeUso CasosDeUso

<PageTitle>Reservas · SmartPark</PageTitle>

<PaginaProtegida Permissao="Permissao.Portal" Recurso="Recurso.Reserva">
    <CabecalhoPagina Titulo="Reservas" Descricao="@($"A estimativa usa a tarifa ativa. Tolerância de {Dominio.Entidades.Reserva.ToleranciaMinutos} minutos após o horário.")">
        <button type="button" class="botao" @onclick="AbrirNovoAsync">Nova reserva</button>
    </CabecalhoPagina>

    <Mensagem Sucesso="@_estado.Sucesso" Erro="@_estado.Erro" />
    <ListaNotificacoes Itens="_notificacoes" />

    <TabelaDados Itens="_reservas" MensagemVazia="Nenhuma reserva registrada.">
        <Cabecalho><th>Veículo</th><th>Vaga</th><th>Data</th><th>Horário</th><th>Duração</th><th>Estimativa</th><th>Status</th><th></th></Cabecalho>
        <Linha Context="reserva">
            <td>@reserva.Veiculo</td>
            <td><strong>@reserva.CodigoVaga</strong></td>
            <td>@reserva.Data.ToString("dd/MM/yyyy")</td>
            <td>@Formatacao.FormatarHora(reserva.Hora)</td>
            <td>@reserva.DuracaoHoras h</td>
            <td>@Formatacao.FormatarMoeda(reserva.ValorEstimado)</td>
            <td><Etiqueta Texto="@Rotulos.De(reserva.Status)" Tom="@CoresStatus.De(reserva.Status)" /></td>
            <td>
                @if (reserva.Status is StatusReserva.Pendente or StatusReserva.Confirmada)
                {
                    <AcoesLinha Rotulo="registro" AoEditar="() => AbrirEdicao(reserva)">
                        <button type="button" class="botao pequeno perigo-contorno" @onclick="() => CancelarAsync(reserva)">Cancelar</button>
                    </AcoesLinha>
                }
                else
                {
                    <AcoesLinha Rotulo="registro" AoExcluir="() => ExcluirAsync(reserva)" />
                }
            </td>
        </Linha>
    </TabelaDados>

    <ModalFormulario Aberto="_estado.ModalAberto" Titulo="@(_estado.Editando ? "Alterar reserva" : "Nova reserva")" TextoSalvar="@(_estado.Editando ? "Salvar" : "Reservar")"
                     Erro="@_estado.ErroFormulario" Salvando="_estado.Salvando" AoSalvar="SalvarAsync" AoFechar="_estado.Fechar">
        <CamposFormulario Campos="Campos" />
    </ModalFormulario>
</PaginaProtegida>

@code {
    private readonly EstadoCrud _estado = new();
    private IReadOnlyList<ReservaDto>? _reservas;
    private IReadOnlyList<string> _notificacoes = [];
    private IReadOnlyList<OpcaoSelecao> _veiculos = [];
    private IReadOnlyList<OpcaoSelecao> _vagasLivres = [];
    private Formulario _formulario = new();

    private sealed class Formulario
    {
        public int VeiculoId { get; set; }
        public int VagaId { get; set; }
        public DateOnly Data { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        public TimeOnly Hora { get; set; } = new(9, 0);
        public decimal? Duracao { get; set; } = 2;
    }

    // Veículo e vaga só são escolhidos na criação; a alteração muda apenas o período
    private IReadOnlyList<CampoFormulario> Campos =>
    [
        CampoFormulario.Selecao("Veículo", () => _formulario.VeiculoId, valor => _formulario.VeiculoId = valor, _veiculos) with { Visivel = () => !_estado.Editando },
        CampoFormulario.Selecao("Vaga livre", () => _formulario.VagaId, valor => _formulario.VagaId = valor, _vagasLivres) with { Visivel = () => !_estado.Editando },
        CampoFormulario.Data("Data", () => _formulario.Data, valor => _formulario.Data = valor),
        CampoFormulario.Hora("Horário", () => _formulario.Hora, valor => _formulario.Hora = valor),
        CampoFormulario.Numero("Duração (horas)", () => _formulario.Duracao, valor => _formulario.Duracao = valor),
    ];

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        if (!Sessao.PodeAcessar(Permissao.Portal, Recurso.Reserva)) return;
        var resultado = await CasosDeUso.ExecutarAsync((ListarReservasManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId)));
        if (resultado.Sucesso) _reservas = resultado.Dados;
        else _estado.InformarErro(resultado.Erro);
    }

    private async Task AbrirNovoAsync()
    {
        var veiculos = await CasosDeUso.ExecutarAsync((ListarVeiculosManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId)));
        var vagas = await CasosDeUso.ExecutarAsync((ListarVagasManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId)));
        _veiculos = (veiculos.Dados ?? []).Select(veiculo => new OpcaoSelecao(veiculo.Id.ToString(), $"{veiculo.Apelido} · {veiculo.PlacaFormatada}")).ToList();
        _vagasLivres = (vagas.Dados ?? []).Where(vaga => vaga.Status == StatusVaga.Livre)
            .Select(vaga => new OpcaoSelecao(vaga.Id.ToString(), $"{vaga.Codigo} · {Rotulos.De(vaga.Tipo)}")).ToList();

        _formulario = new();
        _estado.AbrirNovo();
    }

    private void AbrirEdicao(ReservaDto reserva)
    {
        _formulario = new() { Data = reserva.Data, Hora = reserva.Hora, Duracao = reserva.DuracaoHoras };
        _estado.AbrirEdicao(reserva.Id);
    }

    private async Task SalvarAsync()
    {
        _estado.Salvando = true;
        var duracao = (int)(_formulario.Duracao ?? 0);
        var resultado = _estado.IdEditando is int id
            ? await CasosDeUso.ExecutarAsync((AtualizarReservaManipulador casoDeUso) =>
                casoDeUso.ExecutarAsync(new(Sessao.TenantId, id, _formulario.Data, _formulario.Hora, duracao)))
            : await CasosDeUso.ExecutarAsync((CriarReservaManipulador casoDeUso) =>
                casoDeUso.ExecutarAsync(new(Sessao.TenantId, _formulario.VeiculoId, _formulario.VagaId, _formulario.Data, _formulario.Hora, duracao)));
        _notificacoes = resultado.Dados?.Notificacoes ?? [];
        if (_estado.ConcluirFormulario(resultado.Sucesso, resultado.Erro, "Reserva salva.")) await CarregarAsync();
    }

    private async Task CancelarAsync(ReservaDto reserva)
    {
        var resultado = await CasosDeUso.ExecutarAsync((CancelarReservaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, reserva.Id)));
        _notificacoes = resultado.Dados?.Notificacoes ?? [];
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, $"Reserva da vaga {reserva.CodigoVaga} cancelada.")) await CarregarAsync();
    }

    private async Task ExcluirAsync(ReservaDto reserva)
    {
        var resultado = await CasosDeUso.ExecutarAsync((ExcluirReservaManipulador casoDeUso) => casoDeUso.ExecutarAsync(new(Sessao.TenantId, reserva.Id)));
        if (_estado.ConcluirAcao(resultado.Sucesso, resultado.Erro, "Reserva excluída.")) await CarregarAsync();
    }
}
