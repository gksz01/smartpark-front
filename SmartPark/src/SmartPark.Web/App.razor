<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/smartpark.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SmartPark.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoInterativo" />
</head>

<body>
    <Routes @rendermode="ModoInterativo" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sem pré-renderização: cada tela carrega os dados uma única vez, já conectada ao servidor.
    private static readonly IComponentRenderMode ModoInterativo = new InteractiveServerRenderMode(prerender: false);
}
